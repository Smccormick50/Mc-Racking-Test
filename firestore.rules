// Firestore security rules for Mc Racking-Test.
// Before publishing:
// 1) Firebase Console → Authentication → Sign-in method → enable Anonymous.
// 2) Open the test site once, then look in Authentication → Users for your UID.
// 3) In Firestore, create admins/{YOUR_UID} with: role = "admin", name = "Your Name".
// 4) Publish these rules.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function onlyInventoryQuantityChange() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['currentQuantity', 'updatedAt']);
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid || isAdmin();
      allow write: if isAdmin();
    }

    match /parts/{partId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && onlyInventoryQuantityChange());
    }

    match /invoices/{invId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /inventory_movements/{entryId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /meta/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /audit_log/{entryId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /deletions/{entryId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
  }
}
